# Copy this file to .env and fill it in. The .env file is gitignored.
# Never commit real credentials.

# Credentials for sites that require a login before the application form.
# Leave blank when applying through public ATS links, which need no account.
JOB_SITE_USERNAME=
JOB_SITE_PASSWORD=

# Path to the resume PDF the tool parses and uploads.
RESUME_PATH=resume.pdf

# Optional cover letter file to attach when a form asks for one.
COVER_LETTER_PATH=

# Browser to drive: chrome, edge or firefox.
BROWSER=chrome

# Run without a visible window. Keep this false so you can review before submitting.
HEADLESS=false

# Seconds to wait for elements before giving up.
PAGE_TIMEOUT=15

# Minimum match confidence, 0 to 1, before the engine fills a field.
# Raise it to fill less and review more. Lower it to fill more aggressively.
CONFIDENCE_THRESHOLD=0.55

# Where the application tracker and run reports are written.
DATABASE_PATH=applications.db
OUTPUT_DIR=runs

# Browser session directory. Holds live login cookies; keep it out of the repo.
SESSION_DIR=
